# WandB API Key for experiments tracking
WANDB_API_KEY=your_wandb_api_key_here

# ntfy.sh push notification settings for JupyterHub runs
# Unreserved ntfy.sh topics are public to anyone who learns the topic name.
# Use a random name and keep real values only in the ignored local .env file.
NTFY_TOPIC="replace_with_random_topic_name"
NTFY_TOKEN="your_ntfy_token_here"
# Optional: heartbeat interval in seconds (default: 3600 = 1 hour; 0 to disable)
# NTFY_HEARTBEAT_SEC=3600
